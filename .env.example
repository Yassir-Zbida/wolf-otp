PORT=4000
# Bind address for published app port (use 127.0.0.1 if behind nginx on same host)
APP_BIND=0.0.0.0
TRUST_PROXY=1

REDIS_URL=redis://redis:6379
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default

# WAHA dashboard / API credentials (required)
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Shared secret for WordPress (Wolf Auth) → this API. Min 16 chars.
# Generate: openssl rand -hex 32
API_KEY=

# HMAC secret for hashing OTPs in Redis. Must not contain "changeme".
# Generate: openssl rand -hex 32
OTP_SECRET=

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Per-IP limits (WordPress server IP will be the client)
OTP_IP_RATE_MAX=30
OTP_IP_RATE_WINDOW_MS=3600000
OTP_VERIFY_IP_RATE_MAX=60
OTP_VERIFY_IP_RATE_WINDOW_MS=900000
